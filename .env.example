# ==========================================
# Stream Credentials
# ==========================================
# Stream Public API Key (Client-side)
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key_here

# Stream Secret & API Key (Server-side Next.js API Routes)
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# ==========================================
# Meeting Room & Backend Configuration
# ==========================================
# Default Call ID if not specified
NEXT_PUBLIC_CALL_ID=smart-meeting-room

# Python NaraRouter Backend Assistant URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
